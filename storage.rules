rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Committee logos
    match /committees/{userId}/{allPaths=**} {
      // Readable by anyone logged in or viewing the site
      allow read: if true;
      // Allow upload only by the owner during registration or update, max 5MB, image only
      allow write: if request.auth != null &&
                   request.auth.uid == userId &&
                   request.resource.size < 5 * 1024 * 1024 &&
                   request.resource.contentType.matches('image/.*');
    }
  }
}
